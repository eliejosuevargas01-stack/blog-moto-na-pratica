      "name": "Lista passos em execucao",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [
        240,
        0
      ],
      "parameters": {
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "value": "arAS2xvz1XBxyA57",
          "mode": "list"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "Processando",
              "condition": "isTrue"
            }
          ]
        },
        "returnAll": true
      }
    },
    {
      "id": "4e7300dd-40b6-446d-b19f-339bcf6d659d",
      "name": "Filtra travados (10min-6h)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "jsCode": "const agora = Date.now();\nconst MIN10 = 10 * 60 * 1000;\nconst H6 = 6 * 60 * 60 * 1000;\nconst out = [];\nfor (const item of $input.all()) {\n  const j = item.json;\n  if (j.status !== 'processando' && j.status !== 'auditando') continue;\n  const upd = Date.parse(j.updatedAt || '');\n  if (isNaN(upd)) continue;\n  const idade = agora - upd;\n  if (idade < MIN10) continue;   // ainda pode estar rodando de verdade\n  if (idade > H6) continue;      // não ressuscita pesquisas antigas\n  out.push({ json: {\n    id: j.id,\n    id_pesquisa: j.id_pesquisa,\n    passo_id: j.passo_id,\n    statusAnterior: j.status,\n    novoStatus: j.status === 'processando' ? 'pendente' : 'auditar',\n    alvo: j.status === 'processando' ? 'scrapper' : 'auditor'\n  }});\n}\nreturn out;"
      }
    },
    {
      "id": "fd5365e5-8415-4aea-9b02-4e2d52d9b021",
      "name": "Destrava passo",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [
        720,
        0
      ],
      "parameters": {
        "operation": "update",
        "dataTableId": {
          "__rl": true,
          "value": "arAS2xvz1XBxyA57",
          "mode": "list"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "keyValue": "={{ $json.id }}"
            }
          ]
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "status": "={{ $json.novoStatus }}",
            "Processando": false
          },
          "matchingColumns": [],
          "schema": []
        }
      }
    },
    {
      "id": "465c6cc3-69e8-439a-b7d6-0e7ffd6fa6a2",
      "name": "Agrupa por pesquisa e alvo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "jsCode": "const vistos = new Set();\nconst out = [];\nfor (const item of $input.all()) {\n  const j = item.json;\n  const chave = j.id_pesquisa + '|' + j.alvo;\n  if (vistos.has(chave)) continue;\n  vistos.add(chave);\n  out.push({ json: { id_pesquisa: j.id_pesquisa, alvo: j.alvo } });\n}\nreturn out;"
      }
    },
